    (fn (none | LifewebError)(String* out, Rule* rule)) unparse;
};


@export
type Backend = struct {
    string name;
    Rulespace* space;
    // tbd
};


@export
type PatternData = struct: Box {
    Allocator* allocator;
    Cell[] data;
};

@export
fn none PatternData.destroy(PatternData* this) {
    this.allocator.free(this.data);
}


@export
type PatternRule = struct {
    string str;
    Rulespace* space;
    usize static_symmetry;
    (fn Cell(Pattern* this, Coord pos)) get;
    (fn none(mut Pattern* this, Coord pos, Cell value)) set;
    (fn none(mut Pattern* this)) clear;
    (fn none(mut Pattern* this)) run_generation;
    (fn none(Pattern* this, mut Pattern* out)) copy;
    (fn none(Pattern* this, mut Pattern* out)) copy_rule;
    (fn bool(Pattern* this, Pattern* other)) is_equal;
    (fn bool(Pattern* this, Pattern* other)) is_equal_with_translate;
    (fn uint64(Pattern* this)) hash64;
    (fn none(mut Pattern* this)) shrink_to_fit;
    (fn none(mut Pattern* this, Size size)) ensure;
    (fn none(mut Pattern* this, Coord amount)) offset_by;
    (fn none(mut Pattern* this, Pattern* value, Coord pos, ULPMask mode)) insert;
    (fn none(Pattern* this, mut Pattern* out, Box box)) copy_part;
    (fn none(mut Pattern* this, Box box)) clear_part;
    (fn none(Pattern* this, PatternData* out)) get_data;
    (fn none(Pattern* this, PatternData* data)) set_data;
    (fn none(mut Pattern* this, Transformation value)) transform;
    (fn none(mut Pattern* this, usize times)) inflate;
};

@export
type Pattern = struct: Box {
    PatternRule* rule;
    Coord size;
    Coord offset;
    usize generation;
    usize population;
    Cell bg;
};


@export
@inline
fn Cell Pattern.get(Pattern* this, pos) {
