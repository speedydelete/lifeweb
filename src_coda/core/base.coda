
module lifeweb::core::base;

include std;
include std::types : _;
include std::mem : _;
include std::collections : _;
include std::text : _;


@export
type LifewebError = enum: uint64 {
};

@export
string[] LIFEWEB_ERROR_MEANINGS = {
    .[LifewebError::x] = "y",
};

@export
@noreturn
fn LifewebError.throw(LifewebError this) {
    std::print("LifewebError: {}", [LIFEWEB_ERROR_MEANINGS[this]]);
    std::process::exit(std::process::EXIT_FALIURE);
}

@export
fn T try<T>(value: (T | LifewebError)) {
    match (value) {
        LifewebError {
            value.throw();
        }
        T {
            return value;
        }
    }
}


@export
type Coord = struct {
    int64 x;
    int64 y;
};

@export
fn Coord Coord.copy(Coord* this) {
    return (Coord){
        .x = this.x,
        .y = this.y,
    };
}

@export
fn Coord Coord.add(Coord* this, Coord* other) {
    return (Coord){
        .x = this.x + other.x,
        .y = this.y + other.y,
    };
}

@export
fn none Coord.iadd(mut Coord* this, Coord* other) {
    this.x += other.x;
    this.y += other.y;
}

@export
fn Coord Coord.sub(Coord* this, Coord* other) {
    return (Coord){
        .x = this.x - other.x,
        .y = this.y - other.y,
    };
}

@export
fn none Coord.isub(mut Coord* this, Coord* other) {
    this.x -= other.x;
    this.y -= other.y;
}

@export
fn Coord Coord.abs(Coord* this) {
    return (Coord){
        .x = this.x.abs(),
        .y = this.y.abs(),
    };
}

@export
fn Coord Coord.iabs(mut Coord* this) {
    this.x = this.x.abs();
    this.y = this.y.abs();
}


@export
string RLE_LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWX";
@export
string RLE_PREFIXES = "pqrstuvwxyz";
@export
fn (char | string) get_rle_char(uint64 state, uint64 state_count) {
    if (state == 0) {
        return state_count == 2 ? 'b' : '.';
    } else if (state == 1) {
        return state_count == 2 ? 'o' : 'A';
    } else if (staate < 24) {
        return RLE_LETTERS[state - 1];
    } else {
        String* str;
        str.init(1);
        str.ptr[0] = RLE_LETTERS[state - 1];
        state /= 24;
        while (state > 0) {
            str.unshift(RLE_PREFIXES[state % 11]);
            state /= 11;
        }
        return str.items();
    }
}

@export
string APGCODE_CHARS = "0123456789abcdefghijklmnopqrstuvwxyz";


@export
type StaticRuleSymmetry = enum {
    C1,
    C2,
    C4,
    D2h,
    D2v,
    D2s,
    D2b,
    D4p,
    D4x,
    D8
};

@export
string[] RULE_SYMMETRY_NAMES = {
    .[StaticRuleSymmetry::C1] = "C1",
    .[StaticRuleSymmetry::C2] = "C2",
    .[StaticRuleSymmetry::C4] = "C4",
    .[StaticRuleSymmetry::D2h] = "D2|",
    .[StaticRuleSymmetry::D2v] = "D2-",
    .[StaticRuleSymmetry::D2s] = "D2/",
    .[StaticRuleSymmetry::D2b] = "D2\\",
    .[StaticRuleSymmetry::D4p] = "D4+",
    .[StaticRuleSymmetry::D4x] = "D4x",
    .[StaticRuleSymmetry::D8] = "D8"
};


@export
type ULPMask = enum: uint8 {
    clear = 0b0000,
    set_to_1 = 0b1111,
    copy = 0b0101,
    invert_copy = 0b1010,
    copy_to_0 = 0b1100,
    copy_to_1 = 0b0011,
    and = 0b0001,
    or = 0b0111,
    xor = 0b0110,
    nand = 0b1110,
    nor = 0b1000,
    xnor = 0b1001,
}

@export
type Rulespace = struct {
};

@export
type Rule<T: Pattern, S: Unsigned> = struct {
    string str;
    uint64 states;
    StaticRuleSymmetry static_symmetry;
    Coord[] neighborhood;
    Rulespace* space;
    Allocator* allocator;
    (fn S(T* this, int64 x, int64 y))* get;
    (fn none(mut T* this, int64 x, int64 y, S value))* set;
    (fn none(mut T* this))* clear;
    (fn none(mut T* this))* run_generation;
    (fn none(T* this, mut T* out))* copy;
    (fn none(T* this, mut T* out))* copy_rule;
    (fn bool(T* this, Pattern* other))* is_equal;
    (fn bool(T* this, Pattern* other))* is_equal_with_translate;
    (fn uint64(T* this))* hash64;
    (fn none(mut T* this))* shrink_to_fit;
    (fn none(mut T* this, uint64 top, uint64 bottom, uint64 left, uint64 right))* expand;
    (fn none(mut T* this, uint64 width, uint64 height))* ensure;
    (fn none(mut T* this, int64 x, int64 y))* offset_by;
    (fn none(mut T* this, Pattern* value, int64 x, int64 y, ULPMask mode))* insert;
    (fn none(T* this, mut T* out, int64 x, int64 y, uint64 width, uint64 height))* copy_part;
    (fn none(mut T* this, int64 x, int64 y, uint64 width, uint64 height))* clear_part;
    (fn S[]<U: Unsigned>(T* this, Allocator* allocator))* get_data;
    (fn none(T* this, S[] data))* set_data;
    (fn none(mut T* this))* flip_horizontal;
    (fn none(mut T* this))* flip_vertical;
    (fn none(mut T* this))* rotate_right;
    (fn none(mut T* this))* rotate_left;
    (fn none(mut T* this))* rotate_180;
    (fn none(mut T* this))* flip_diagonal;
    (fn none(mut T* this))* flip_anti_diagonal;
    (fn none(mut T* this, uint64 times))* inflate;
};

@export
type Pattern<T: Pattern, S: Unsigned> = struct {
    Rule<T, S>* rule;
    uint64 width;
    uint64 height;
    int64 x_offset;
    int64 y_offset;
    uint64 generation;
    uint64 population;
};

@export
@inline
fn S Pattern<T, S>.get<T: Pattern, S: Unsigned>(Pattern<T, S>* this, int64 x, int64 y) {
    return this.rule.get(this, x, y);
}

@export
@inline
fn none Pattern<T, S>.set<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this, int64 x, int64 y, S value) {
    this.rule.set(this, x, y, value);
}

@export
@inline
fn none Pattern<T, S>.clear<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this) {
    this.rule.set(this);
}

@export
@inline
fn none Pattern<T, S>.run_generation<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this) {
    this.rule.run_generation(this);
}

@export
fn none Pattern<T, S>.run<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this, usize gens) {
    for (mut usize i = 0; i < gens; i += 1) {
        this.run_generation();
    }
}

@export
@inline
fn none Pattern<T, S>.is_empty<T: Pattern, S: Unsigned>(Pattern<T, S>* this) {
    return this.population == 0;
}

@export
@inline
fn none Pattern<T, S>.copy<T: Pattern, S: Unsigned>(Pattern<T, S>* this, mut Pattern<T, S>* out) {
    this.rule.copy(this, out);
}

@export
@inline
fn none Pattern<T, S>.copy_rule<T: Pattern, S: Unsigned>(Pattern<T, S>* this, mut Pattern<T, S>* out) {
    this.rule.copy_rule(this, out);
}

@export
@inline
fn bool Pattern<T, S>.is_equal<T: Pattern, S: Unsigned>(Pattern<T, S>* this, Pattern* other) {
    return this.rule.is_equal(this, other);
}

@export
@inline
fn bool Pattern<T, S>.is_equal_with_translate<T: Pattern, S: Unsigned>(Pattern<T, S>* this, Pattern* other) {
    return this.rule.is_equal_with_translate(this, other);
}

@export
@inline
fn uint64 Pattern<T, S>.hash64<T: Pattern, S: Unsigned>(Pattern<T, S>* this) {
    return this.rule.hash64(this);
}

@export
@inline
fn none Pattern<T, S>.shrink_to_fit<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this) {
    this.rule.shrink_to_fit(this);
}

@export
@inline
fn none Pattern<T, S>.expand<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this, uint64 top, uint64 bottom, uint64 left, uint64 right) {
    this.rule.expand(this, top, bottom, left, right);
}

@export
@inline
fn none Pattern<T, S>.ensure<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this, uint64 width, uint64 height) {
    this.rule.ensure(this, width, height);
}

@export
@inline
fn none Pattern<T, S>.offset_by<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this, int64 x, int64 y) {
    this.rule.offset_by(this, x, y);
}

@export
@inline
fn none Pattern<T, S>.insert<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this, mut Pattern* value, int64 x, int64 y, ULPMask mode) {
    this.rule.insert(this, value, x, y, mode);
}

@export
@inline
fn none Pattern<T, S>.copy_part<T: Pattern, S: Unsigned>(Pattern<T, S>* this, mut Pattern<T, S> out, int64 x, int64 y, uint64 width, uint64 height) {
    this.rule.copy_part(this, out, x, y, width, height);
}

@export
@inline
fn none Pattern<T, S>.clear_part<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this, int64 x, int64 y, uint64 width, uint64 height) {
    this.rule.copy_part(this, x, y, width, height);
}

@export
@inline
fn S[] Pattern<T, S>.get_data<T: Pattern, S: Unsigned>(Pattern<T, S>* this, Allocator* allocator) {
    return this.rule.get_data(this, allocator);
}

@export
@inline
fn none Pattern<T, S>.set_data<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this, S[] data) {
    this.rule.set_data(this, data);
}

@export
@inline
fn none Pattern<T, S>.flip_horizontal<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this) {
    this.rule.flip_horizontal(this);
}

@export
@inline
fn none Pattern<T, S>.flip_vertical<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this) {
    this.rule.flip_vertical(this);
}

@export
@inline
fn none Pattern<T, S>.rotate_left<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this) {
    this.rule.rotate_left(this);
}

@export
@inline
fn none Pattern<T, S>.rotate_right<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this) {
    this.rule.rotate_right(this);
}

@export
@inline
fn none Pattern<T, S>.rotate_180<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this) {
    this.rule.rotate_180(this);
}

@export
@inline
fn none Pattern<T, S>.flip_diagonal<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this) {
    this.rule.flip_diagonal(this);
}

@export
@inline
fn none Pattern<T, S>.flip_anti_diagonal<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this) {
    this.rule.flip_anti_diagonal(this);
}

@export
@inline
fn none Pattern<T, S>.inflate<T: Pattern, S: Unsigned>(mut Pattern<T, S>* this, uint64 times) {
    this.rule.inflate(this, times);
}
