@export
string RLE_LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWX";
@export
string RLE_PREFIXES = "pqrstuvwxyz";
@export
fn none state_to_rle_str(Cell state, Cell state_count, String* str) {
    if (state > 24) {
        str.ptr[0] = RLE_LETTERS[state - 1];
        state /= 24;
        while (state > 0) {
            str.unshift(RLE_PREFIXES[state % 11]);
            state /= 11;
        }
        return str.to_array();
    }
    char out;
    if (state == 0) {
        if (state_count == 2) {
            out = 'b';
        } else {
            out = '.';
        }
    } else if (state == 1) {
        if (state_count == 2) {
            out = 'o';
        } else {
            out = 'A';
        }
    } else {
        out = RLE_LETTERS[state - 1];
    }
    string out_str = {out};
    return out_str.to_array();
}

@export
fn String* Pattern.to_rle(Pattern* this, Allocator* allocator, bool header) {
    mut String* out;
    out.init(lifeweb_heap, 0);
    defer out.destroy();
    uint64 height = this.height;
    uint64 width = this.width;
    PatternData data;
    data.allocator = allocator;
    defer data.destroy();
    this.get_data(&data);
    out.clear();
    if (header) {
        out.add(format(lifeweb_heap, "x = {}, y = {}, rule = {}\n", [width, height, this.rule.str]));
    }
    uint64 i = 0;
    mut String* line;
    line.init(lifeweb_heap, 0);
    defer line.destroy();
    uint64 dollar_count = 0;
    bool is_start = true;
    mut String* state_str;
    state_str.init(lifeweb_heap, 1);
    defer state_str.destroy()
    for (mut uint64 y = 0; y < height; y += 1) {
        if (data.every_slice(i, i + width, fn bool(S value) {return value == 0;})) {
            dollar_count += 1;
            i += width;
            continue;
        }
        if (!is_start) {
            uint64 prev_line_len = line.len;
            if (dollar_count > 0) {
                line.add(format(lifeweb_heap, "{}", dollar_count + 1));
                dollar_count = 0;
            }
            line.add("$");
            if (line.len > 69) {
                out.add(line.view(0, prev_line_len));
                out.add("\n");
                line.delete_slice(0, prev_line_len);
            }
        } else if (dollar_count > 0) {
            uint64 prev_line_len = line.len;
            line.add(format(lifeweb_heap, "{}", dollar_count + 1));
            line.add("$");
            dollar_count = 0;
            if (line.len > 69) {
                out.add(line.view(0, prev_line_len));
                out.add("\n");
                line.delete_slice(0, prev_line_len);
            }
        }
        is_start = false;
        Cell prev_state = 0;
        uint64 count = 0;
        for (mut uint64 x = 0; x < width; x += 1) {
            Cell state = data[i];
            if (state == prev_state && count != 0) {
                count += 1;
            } else {
                uint64 prev_line_len = line.len;
                if (count > 1) {
                    line.add(format(lifeweb_heap, "{}", count));
                }
                state_str.reset(lifeweb_heap, 1).try();
                state_to_rle_str(prev_state, this.rule.states, state_str);
                line.add(state_str);
                dollar_count = 0;
                if (line.len > 69) {
                    out.add(line.view(0, prev_line_len));
                    out.add("\n");
                    line.delete_slice(0, prev_line_len);
                }
                prev_state = state;
                count = 1;
            }
            i += 1;
        }
        if (count > 0 && prev_state != 0) {
            if (count > 1) {
                line.add(format(lifeweb_heap, "{}", count));
            }
            line.add(state_to_rle_str(prev_state));
            dollar_count = 0;
            if (line.len > 69) {
                out.add(line.view(0, prev_line_len));
                out.add("\n");
                line.delete_slice(0, prev_line_len);
            }
        }
    }
    out.add(line);
    out.add("!");
}

@export
fn (none | LifewebError::INVALID_RLE | LifewebError::INVALID_STATE_FOR_RULE) Pattern.load_rle(Pattern* this, GenericString* rle) {
    // first determine the width and height
    mut usize height = 0;
    mut usize width = 0;
    mut uint64 current_run = 1;
    mut uint64 current_width = 0;
    for (mut usize i = 0; i < rle.len; i += 1) {
        char c = rle.ptr[i];
        if (c.is_digit()) {
            if (current_run == 1) {
                current_run = c - '0';
            } else {
                current_run = (current_run * 10) + (c - '0');
            }
        } else if (c == '$') {
            if (current_width > width) {
                width = current_width;
            }
            height += current_run;
            current_run = 1;
        } else {
            // get rid of prefixes
            while (c.is_lower()) {
                i += 1;
                if (i == rle.len) {
                    // unterminated prefix
                    return LifewebError::INVALID_RLE;
                }
                c = rle.ptr[i];
            }
            width += current_run;
            current_run = 1;
        }
    }
    if (current_width > width) {
        width = current_width;
    }
    Cell[] data = this.rule.allocator.alloc<Cell>(height * width);
    data.fill(0);
    // now fill in the data
    current_run = 1;
    mut uint64 i = 0;
    mut uint64 y = 0;
    for (mut usize i = 0; i < rle.len; i += 1) {
        char c = rle.ptr[i];
        if (c.is_digit()) {
            if (current_run == 1) {
                current_run = c - '0';
            } else {
                current_run = (current_run * 10) + (c - '0');
            }
        } else if (c == '.' || c == 'b') {
            i += current_run;
            current_run = 1;
        } else if (c == '$') {
            if (current_width > width) {
                width = current_width;
            }
            y += current_run;
            current_run = 1;
            i = y * width;
        } else {
            mut uint64 state = 1;
            if (c == 'o') {
                state = 1;
            } else {
                state = 0;
                while (c.is_lower()) {
                    (usize | none) index = RLE_PREFIXES.index_of(c);
                    if (#tag_check(index, none)) {
                        return LifewebError::INVALID_RLE;
                    }
                    if (state == 0) {
                        state = index + 1;
                    } else {
                        state = (state * 11) + index;
                    }
                    i += 1;
                    if (i == rle.len) {
                        // unterminated prefix
                        return LifewebError::INVALID_RLE;
                    }
                    c = rle.ptr[i];
                }
                (usize | none) index2 = RLE_LETTERS.index_of(c);
                if (#tag_check(index2, none)) {
                    // invalid character
                    return LifewebError::INVALID_RLE;
                }
                state = (state * 24) + index2 + 1;
            }
            if (state > this.rule.states) {
                return LifewebError::INVALID_STATE_FOR_RULE;
            }
            for (mut usize j = 0; j < current_run; j += 1) {
                data[i + j] = state;
            }
            i += current_run;
            current_run = 1;
        }
    }
    this.set_data(height, width, data);
}

@export
string APGCODE_CHARS = "0123456789abcdefghijklmnopqrstuvwxyz";

@export
string APGCODE_ZEROS = {"0", "w", "x", "y0", "y1", "y2", "y3", "y4", "y5", "y6", "y7", "y8", "y9", "ya", "yb", "yc", "yd", "ye", "yf", "yg", "yh", "yi", "yj", "yk", "yl", "ym", "yn", "yo", "yp", "yq", "yr", "ys", "yt", "yu", "yv", "yw", "yx", "yy", "yz"};

@inline
fn none layer_to_apgcode(Pattern* this, mut String* out, uint8[] layer) {
    uint64 height = this.height;
    uint64 width = this.width;
    uint64 strips = math::ceil_div(height, 5);
    for (mut 
    uint64 strip = 0; strip < strips; strip += 1) {
        uint64 zeros = 0;
        uint64 start = strip * width * 5;
        mut uint64 strip_height;
        if (strip == strips - 1) {
            if (height % 5 == 0) {
                strip_height = 5;
            } else {
                strip_height = height % 5;
            }
        } else {
            strip_height = 5;
        }
        for (mut uint64 x = 0; x < width; x += 1) {
            char c;
            if (strip_height == 5) {
                c = APGCODE_CHARS[data[start + x] | (data[start + width + x] << 1) | (data[start + 2*width + x] << 2) | (data[start + 3*width + x] << 3) | (data[start + 4*width + x] << 4)];
            } else {
                uint8 value = 0;
                for (mut uint8 i = 0; i < strip_height; i += 1) {
                    value |= data[start + i*width + x] << i;
                }
                c = APGCODE_CHARS[value];
            }
            if (c == '0') {
                zeros += 1;
            } else {
                if (zeros > 0) {
                    while (zeros > 39) {
                        zeros -= 39;
                        out.add("yz");
                    }
                    out.add(APGCODE_ZEROS[zeros]);
                }
                out.add(c);
            }
        }
    }
}

@export
fn String Pattern.to_apgcode(Pattern* this) {
    mut String* out;
    out.init(lifeweb_heap, 0);
    defer out.destroy();
    if (this.rule.states == 2 && T == uint8) {
        layer_to_apgcode(this, this.data, out);
        return;
    }
    mut uint8[] layer_data = lifeweb_heap.alloc<uint8>(this.height * this.width);
    defer lifeweb_heap.free(layer_data);
    this.data.map_to(layer_data, fn uint8(T value) {if (value == 1) {return 1;} else {return 0;}});
    layer_to_apgcode(this, out, layer_data);
    this.data.map_to(layer_data, fn uint8(T value) {if (value > 1) {return 1;} else {return 0;}});
    out.add("_");
    layer_to_apgcode(this, out, layer_data);
    uint64 layers = math::ceil_log2(this.rule.states - 2);
    if (layers > 0) {
        uint8[] data2 = lifeweb_heap.alloc<T>(this.height * this.width);
        this.data.map_to(data2, fn uint64(T value) {if (value < 2) {return 0;} else {return (this.rule.states - (uint64)value) * 4 - 2;}});
        for (mut uint64 layer = 0; layer < layers; layer += 1) {
            data2.map_to(layer_data, fn uint8(uint64 value){return value & (1 << layer)});
            out.add("_");
            layer_to_apgcode(this, out, layer_data);
        }
        lifeweb_heap.free(data2);
    }
    lifeweb_heap.free(layer_data);
    return out;
}
