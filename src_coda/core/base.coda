}

@export
@inline
fn none Pattern.run_generation(mut Pattern* this) {
    this.rule.run_generation(this);
}

@export
fn none Pattern.run(mut Pattern* this, usize gens) {
    for (mut usize i = 0; i < gens; i += 1) {
        this.run_generation();
    }
}

@export
@inline
fn none Pattern.is_empty(Pattern* this) {
    return this.population == 0;
}

@export
@inline
fn none Pattern.copy(Pattern* this, mut Pattern* out) {
