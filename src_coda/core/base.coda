
module lifeweb::core::base;

include std;
include std::types : _;
include std::mem : _;
include std::collections : _;
include std::text : _;
include std::fmt : _;
include math;


@export
type LifewebError = enum: uint64 {
    INVALID_RLE,
    INVALID_STATE_FOR_RULE,
};

@export
string[] LIFEWEB_ERROR_MEANINGS = {
    .[LifewebError::INVALID_RLE] = "Invalid RLE",
    .[LifewebError::INVALID_STATE_FOR_RULE] = "Invalid state for rule",
};

@export
@noreturn
fn LifewebError.throw(LifewebError this) {
    // TO IMPROVE WHEN BETTER IO API
    String* msg;
    msg.init(lifeweb_heap, 0);
    msg.add("LifewebError: ");
    msg.add(LIFEWEB_ERROR_MEANINGS[this]);
    fatal_error(msg.to_array());
}

@export
@inline
fn T (T | LifewebError).try((T | LifewebError) this) {
    if (#tag_check(this, LifewebError)) {
        this.throw();
    } else {
        return this;
    }
}


// global allocator
// yes we ARE doing this
Allocator* lifeweb_heap;


@export
type ULPMask = enum: uint8 {
    CLEAR = 0b0000,
    SET_TO_0 = 0b0000,
    SET_TO_1 = 0b1111,
    COPY = 0b0101,
    INVERT_COPY = 0b1010,
    COPY_TO_0 = 0b1100,
    COPY_TO_1 = 0b0011,
    AND = 0b0001,
    OR = 0b0111,
    XOR = 0b0110,
    NAND = 0b1110,
    NOR = 0b1000,
    XNOR = 0b1001,
};



@export
constraint Vector2Like = {
    Integer x;
    Integer y;
};


@export
type Coord = struct {
    int64 x;
    int64 y;
};

@export
fn Coord Coord.copy(Coord* this) {
    return (Coord){
        .x = this.x,
        .y = this.y,
    };
}

@export
fn Coord Coord.add(Coord* this, Vector2Like* other) {
    return (Coord){
        .x = this.x + other.x,
        .y = this.y + other.y,
    };
}

@export
fn Coord Coord.sub(Coord* this, Vector2Like* other) {
    return (Coord){
        .x = this.x - other.x,
        .y = this.y - other.y,
    };
}

@export
fn Coord Coord.abs(Coord* this) {
    return (Coord){
        .x = this.x.abs(),
        .y = this.y.abs(),
    };
}

@export
fn none Coord.copy_to(Coord* this, mut Coord* out) {
    out.x = this.x;
    out.y = this.y;
}

@export
fn none Coord.iadd(mut Coord* this, Vector2Like* other) {
    this.x += other.x;
    this.y += other.y;
}

@export
fn none Coord.isub(mut Coord* this, Vector2Like* other) {
    this.x -= other.x;
    this.y -= other.y;
}

@export
fn none Coord.iabs(mut Coord* this) {
    this.x = this.x.abs();
    this.y = this.y.abs();
}


@export
type Size = struct {
    uint64 width;
    uint64 height;
};

@export
fn Size Size.copy(Size* this) {
    return (Size){
        .x = this.x,
        .y = this.y,
    };
}

@export
fn Size Size.add(Size* this, Vector2Like* other) {
    return (Size){
        .x = this.x + other.x,
        .y = this.y + other.y,
    };
}

@export
fn Size Size.sub(Size* this, Vector2Like* other) {
    mut uint64 x;
    if (other.x > this.x) {
        x = 0;
    } else {
        x = this.x - other.x;
    }
    mut uint64 y;
    if (other.y > this.y) {
        y = 0;
    } else {
        y = this.y - other.y;
    }
    return (Box){
        .x = x,
        .y = y,
    };
}

@export
fn Size Size.abs(Size* this) {
    return (Size){
        .x = this.x.abs(),
        .y = this.y.abs(),
    };
}

@export
fn none Size.copy_to(Size* this, mut Size* out) {
    out.x = this.x;
    out.y = this.y;
}

@export
fn none Size.iadd(mut Size* this, Vector2Like* other) {
    this.x += other.x;
    this.y += other.y;
}

@export
fn none Size.isub(mut Size* this, Vector2Like* other) {
    if (other.x > this.x) {
        this.x = 0;
    } else {
        this.x -= other.x;
    }
    if (other.y > this.y) {
        this.y = 0;
    } else {
        this.y -= other.y;
    }
}

@export
fn none Size.iabs(mut Size* this) {
    this.x = this.x.abs();
    this.y = this.y.abs();
}


@export
type Box = struct {
    Coord pos;
    Size size;
};


@export
type Transformation = fn Coord(Coord value);


@export
type Cell = uint64;

@export
type Transition = uint64;

@export
type Symmetry = fn none(Transition tr, List<Transition>* on, List<Transition>* off);


@export
type StaticSymmetryID = usize;

@export
type StaticSymmetryInfo = struct {
    string name;
    Symmetry[] data;
};

@export
// all of them have to be either on, off, or groups
// because these are confocaloid transitions
// 1 - on
// -1 - off
// >1 - group forces on
// <1 - group forces off
type Bind = int64;
@export
Bind OFF = -1;
@export
Bind ON = 1;
@export
type Rulespace = struct {
    Rulespace*? super;
    Allocator allocator;
    string name;
    Cell states;
    Coord[] neighborhood;
    uint64 range;
    Transition tr_count;
    Coord[] tr_neighborhood;
    (fn Transition(Cell[] cells, Cell next)) create_tr;
    (fn Cell(Transition tr)) get_tr_next;
    (fn Transition(Transition tr, Cell next)) set_tr_next;
    (fn bool(Transition x, Transition y)) trs_have_same_condition;
    (StaticSymmetryID | none) super_static_symmetry;
    StaticSymmetryInfo[] static_symmetries;
    StaticSymmetryID[][] static_symmetry_join;
    StaticSymmetryID[][] static_symmetry_meet;
    Bind[] binds;
    Bind next_bind_group;
};

@export
fn none Rulespace.init(mut Rulespace* this, Allocator* allocator) {
    this.allocator = allocator;
    this.binds = allocator.alloc<Bind>(this.tr_count);
    this.binds.fill(9);
    this.next_bind_group = 2;
    for (mut Transition tr = 0; tr < this.tr_count; tr += 1) {
        if (this.binds[tr] == 0) {
            Bind group = this.get_new_bind_group();
            this.binds[tr] = group;
            usize next = this.get_tr_next(tr);
            for (mut Cell state = 0; state < this.states; state += 1) {
                if (state == next) {
                    continue;
                }
                this.binds[this.set_tr_next(tr, state)] = group;
            }
        }
    }
}

@export
fn none Rulespace.destroy(mut Rulespace* this) {
    this.allocator.free(this.binds);
}

@export
fn bool Rulespace.init_subspace(Rulespace* this, mut Rulespace* out, Allocator* allocator) {
    out.super = this;
    out.states = this.states;
    out.neighborhood = this.neighborhood;
    out.range = this.range;
    out.tr_count = this.tr_count;
    out.tr_neighborhood = this.tr_neighborhood;
    out.create_tr = this.create_tr;
    out.get_tr_next = this.get_tr_next;
    out.set_tr_next = this.set_tr_next;
    out.trs_have_same_condition = this.trs_have_same_condition;
    out.init(allocator);
}

@export
fn Bind Rulespace.get_new_bind_group(mut Rulespace* this, Allocator* allocator) {
    Bind out = this.next_bind_group;
    this.next_bind_group += 1;
    return out;
}

// all of these return true if no contradiction, false if contradiction

@export
fn bool Rulespace.set_bind(mut Rulespace* this, Transition tr, Bind value) {
    Bind old = this.binds[tr];
    if (old == OFF || old == ON) {
        if (value == OFF || value == ON) {
            return old == value;
        }
        for (mut Transition tr2 = 0; tr2 < this.tr_count; tr2 += 1) {
            if (this.binds[tr2] == old) {
                this.binds[tr2] = value;
            } else if (this.binds[tr2] == -old) {
                this.binds[tr2] = -value;
            }
        }
    } else {
        for (mut Transition tr2 = 0; tr2 < this.tr_count; tr2 += 1) {
            if (this.binds[tr2] == old) {
                this.binds[tr2] = value;
            } else if (this.binds[tr2] == -old) {
                this.binds[tr2] =-value;
            }
        }
    }
    return true;
}

@export
fn bool Rulespace.force_off(mut Rulespace* this, Transition tr) {
    return #inline(this.set_bind(tr, OFF));
}

@export
fn bool Rulespace.force_on(mut Rulespace* this, Transition tr) {
    return #inline(this.set_bind(tr, ON));
}

@export
fn bool Rulespace.bind(mut Rulespace* this, Transition x, Transition y) {
    return #inline(this.set_bind(x, this.binds[y]));
}

@export
fn bool Rulespace.not_bind(mut Rulespace* this, Transition x, Transition y) {
    return #inline(this.set_bind(x, -this.binds[y]));
}

@export
fn bool Rulespace.apply_symmetry(mut Rulespace* this, Symmetry symmetry) {
    List<Transition> on;
    on.init(lifeweb_heap, this.tr_count);
    defer on.destroy();
    List<Transition> off;
    off.init(lifeweb_heap, this.tr_count);
    defer off.destroy();
    for (mut Transition tr = 0; tr < this.tr_count; tr += 1) {
        on.clear();
        off.clear();
        symmetry(tr, &on, &off);
        for (mut usize i = 0; i < on.len; i += 1) {
            this.bind(tr, on.ptr[i]);
        }
        for (mut usize i = 0; i < off.len; i += 1) {
            this.bind(tr, off.ptr[i]);
        }
    }
}

@export
fn bool Rulespace.apply_symmetries(mut Rulespace* this, Symmetry[] symmetries) {
    List<Transition> on;
    on.init(lifeweb_heap, this.tr_count);
    defer on.destroy();
    List<Transition> off;
    off.init(lifeweb_heap, this.tr_count);
    defer off.destroy();
    for (mut usize i = 0; i < this.tr_count; i += 1) {
        for (mut Transition tr = 0; tr < this.tr_count; tr += 1) {
            on.clear();
            off.clear();
            symmetries[i](tr, &on, &off);
            for (mut usize i = 0; i < on.len; i += 1) {
                this.bind(tr, on[i]);
            }
            for (mut usize i = 0; i < off.len; i += 1) {
                this.bind(tr, off[i]);
            }
        }
    }
}


@export
type Rule = struct {
    Rulespace* space;
    bool[] data;
};

@export
fn none Rule.set_to_min(Rule* this) {
    for (mut Transition tr = 0; tr < this.space.tr_count; tr += 1) {
        if (this.space.binds[tr] == ON) {
            this.data[tr] = true;
        } else {
            this.data[tr] = false;
        }
    }
}

@export
fn none Rule.set_to_max(Rule* this) {
    for (mut Transition tr = 0; tr < this.space.tr_count; tr += 1) {
        if (this.space.binds[tr] != OFF) {
            this.data[tr] = true;
        } else {
            this.data[tr] = false;
        }
    }
}

@export
fn bool Rule.set(Rule* this, Transition tr, bool value) {
    Bind bind = this.space.binds[tr];
    if (bind == ON) {
        if (!value) {
            return false;
        }
    } else if (bind == OFF) {
        if (!value) {
            return true;
        }
    } else {
        for (mut Transition tr2 = 0; tr2 < this.space.tr_count; tr2 += 1) {
            if (this.binds[tr2] == bind) {
                this.data[tr2] = value;
            } else if (this.binds[tr2] == -bind) {
                this.data[tr2] = !value;
            }
        }
    }
}

@export
fn bool Rule.enable(Rule* this, Transition tr) {
    return #inline(this.set(tr, true));
}

@export
fn bool Rule.disable(Rule* this, Transition tr) {
    return #inline(this.set(tr, false));
}


@export
type RuleParser = struct {
    string name;
