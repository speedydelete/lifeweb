
module lifeweb::core::base;

include std;
include std::types : _;
include std::mem : _;
include std::collections : _;
include std::text : _;
include std::fmt : _;
include math;


@export
type LifewebError = enum: uint64 {
    INVALID_RLE,
    INVALID_STATE_FOR_RULE,
};

@export
string[] LIFEWEB_ERROR_MEANINGS = {
    .[LifewebError::INVALID_RLE] = "Invalid RLE",
    .[LifewebError::INVALID_STATE_FOR_RULE] = "Invalid state for rule",
};

@export
@noreturn
fn LifewebError.throw(LifewebError this) {
    std::error::fatal_error(format(default_heap, "LifewebError: {}", [LIFEWEB_ERROR_MEANINGS[this]]));
}

@export
@inline
fn T (T | LifewebError).try((T | LifewebError) this) {
    match (this) {
        LifewebError {
            this.throw();
        }
        T {
            return this;
        }
    }
}


@export
type Coord = struct {
    int64 x;
    int64 y;
};

@export
fn Coord Coord.copy(Coord* this) {
    return (Coord){
        .x = this.x,
        .y = this.y,
    };
}

@export
fn Coord Coord.add(Coord* this, Coord* other) {
    return (Coord){
        .x = this.x + other.x,
        .y = this.y + other.y,
    };
}

@export
fn none Coord.iadd(mut Coord* this, Coord* other) {
    this.x += other.x;
    this.y += other.y;
}

@export
fn Coord Coord.sub(Coord* this, Coord* other) {
    return (Coord){
        .x = this.x - other.x,
        .y = this.y - other.y,
    };
}

@export
fn none Coord.isub(mut Coord* this, Coord* other) {
    this.x -= other.x;
    this.y -= other.y;
}

@export
fn Coord Coord.abs(Coord* this) {
    return (Coord){
        .x = this.x.abs(),
        .y = this.y.abs(),
    };
}

@export
fn Coord Coord.iabs(mut Coord* this) {
    this.x = this.x.abs();
    this.y = this.y.abs();
}


@export
type StaticRuleSymmetry = enum {
    C1,
    C2,
    C4,
    D2h,
    D2v,
    D2s,
    D2b,
    D4p,
    D4x,
    D8
};

@export
string[] RULE_SYMMETRY_NAMES = {
    .[StaticRuleSymmetry::C1] = "C1",
    .[StaticRuleSymmetry::C2] = "C2",
    .[StaticRuleSymmetry::C4] = "C4",
    .[StaticRuleSymmetry::D2h] = "D2|",
    .[StaticRuleSymmetry::D2v] = "D2-",
    .[StaticRuleSymmetry::D2s] = "D2/",
    .[StaticRuleSymmetry::D2b] = "D2\\",
    .[StaticRuleSymmetry::D4p] = "D4+",
    .[StaticRuleSymmetry::D4x] = "D4x",
    .[StaticRuleSymmetry::D8] = "D8",
};


@export
type ULPMask = enum: uint8 {
    clear = 0b0000,
    set_to_1 = 0b1111,
    copy = 0b0101,
    invert_copy = 0b1010,
    copy_to_0 = 0b1100,
    copy_to_1 = 0b0011,
    and = 0b0001,
    or = 0b0111,
    xor = 0b0110,
    nand = 0b1110,
    nor = 0b1000,
    xnor = 0b1001,
}

@export
type Backend = struct {
    uint64 transition_count;
    // tbd
};

@export
type Rulespace = struct {
    uint64 size;
    // tbd
};

@export
type RuleParser = struct {
    Backend* backend;
    Rulespace* space;
    (fn (Pattern | LifewebError)(string rule)) parse;
};

@export
type RuleUnparser = struct {
    Rulespace* space;
    (fn (String | LifewebError)(Pattern p)) unparse;
}

@export
type Rule<T: Unsigned> = struct {
    string str;
    uint64 states;
    StaticRuleSymmetry static_symmetry;
    Coord[] neighborhood;
    Rulespace* space;
    Allocator* allocator;
    (fn T(Pattern* this, int64 x, int64 y))* get;
    (fn none(mut Pattern* this, int64 x, int64 y, T value))* set;
    (fn none(mut Pattern* this))* clear;
    (fn none(mut Pattern* this))* run_generation;
    (fn none(Pattern* this, mut Pattern* out))* copy;
    (fn none(Pattern* this, mut Pattern* out))* copy_rule;
    (fn bool(Pattern* this, Pattern* other))* is_equal;
    (fn bool(Pattern* this, Pattern* other))* is_equal_with_translate;
    (fn uint64(Pattern* this))* hash64;
    (fn none(mut Pattern* this))* shrink_to_fit;
    (fn none(mut Pattern* this, uint64 top, uint64 bottom, uint64 left, uint64 right))* expand;
    (fn none(mut Pattern* this, uint64 width, uint64 height))* ensure;
    (fn none(mut Pattern* this, int64 x, int64 y))* offset_by;
    (fn none(mut Pattern* this, Pattern* value, int64 x, int64 y, ULPMask mode))* insert;
    (fn none(Pattern* this, mut Pattern* out, int64 x, int64 y, uint64 width, uint64 height))* copy_part;
    (fn none(mut Pattern* this, int64 x, int64 y, uint64 width, uint64 height))* clear_part;
    (fn T[](Pattern* this, Allocator* allocator))* get_data;
    (fn none(Pattern* this, uint64 width, uint64 height, T[] data))* set_data;
    (fn none(mut Pattern* this))* flip_horizontal;
    (fn none(mut Pattern* this))* flip_vertical;
    (fn none(mut Pattern* this))* rotate_right;
    (fn none(mut Pattern* this))* rotate_left;
    (fn none(mut Pattern* this))* rotate_180;
    (fn none(mut Pattern* this))* flip_diagonal;
    (fn none(mut Pattern* this))* flip_anti_diagonal;
    (fn none(mut Pattern* this, uint64 times))* inflate;
};

@export
type Pattern<T: Unsigned> = struct {
    Rule<T>* rule;
    uint64 width;
    uint64 height;
    int64 x_offset;
    int64 y_offset;
    uint64 generation;
    uint64 population;
};


@export
@inline
fn S Pattern<T>.get<T: Pattern>(Pattern<T>* this, int64 x, int64 y) {
    return this.rule.get(this, x, y);
}

@export
@inline
fn none Pattern<T>.set<T: Unsigned>(mut Pattern<T>* this, int64 x, int64 y, S value) {
    this.rule.set(this, x, y, value);
}

@export
@inline
fn none Pattern<T>.clear<T: Unsigned>(mut Pattern<T>* this) {
    this.rule.set(this);
}

@export
@inline
fn none Pattern<T>.run_generation<T: Unsigned>(mut Pattern<T>* this) {
    this.rule.run_generation(this);
}

@export
fn none Pattern<T>.run<T: Unsigned>(mut Pattern<T>* this, usize gens) {
    for (mut usize i = 0; i < gens; i += 1) {
        this.run_generation();
    }
}

@export
@inline
fn none Pattern<T>.is_empty<T: Unsigned>(Pattern<T>* this) {
    return this.population == 0;
}

@export
@inline
fn none Pattern<T>.copy<T: Unsigned>(Pattern<T>* this, mut Pattern<T>* out) {
    this.rule.copy(this, out);
}

@export
@inline
fn none Pattern<T>.copy_rule<T: Unsigned>(Pattern<T>* this, mut Pattern<T>* out) {
    this.rule.copy_rule(this, out);
}

@export
@inline
fn bool Pattern<T>.is_equal<T: Unsigned>(Pattern<T>* this, Pattern* other) {
    return this.rule.is_equal(this, other);
}

@export
@inline
fn bool Pattern<T>.is_equal_with_translate<T: Unsigned>(Pattern<T>* this, Pattern* other) {
    return this.rule.is_equal_with_translate(this, other);
}

@export
@inline
fn uint64 Pattern<T>.hash64<T: Unsigned>(Pattern<T>* this) {
    return this.rule.hash64(this);
}

@export
@inline
fn none Pattern<T>.shrink_to_fit<T: Unsigned>(mut Pattern<T>* this) {
    this.rule.shrink_to_fit(this);
}

@export
@inline
fn none Pattern<T>.expand<T: Unsigned>(mut Pattern<T>* this, uint64 top, uint64 bottom, uint64 left, uint64 right) {
    this.rule.expand(this, top, bottom, left, right);
}

@export
@inline
fn none Pattern<T>.ensure<T: Unsigned>(mut Pattern<T>* this, uint64 width, uint64 height) {
    this.rule.ensure(this, width, height);
}

@export
@inline
fn none Pattern<T>.offset_by<T: Unsigned>(mut Pattern<T>* this, int64 x, int64 y) {
    this.rule.offset_by(this, x, y);
}

@export
@inline
fn none Pattern<T>.insert<T: Unsigned>(mut Pattern<T>* this, mut Pattern* value, int64 x, int64 y, ULPMask mode) {
    this.rule.insert(this, value, x, y, mode);
}

@export
@inline
fn none Pattern<T>.copy_part<T: Unsigned>(Pattern<T>* this, mut Pattern<T> out, int64 x, int64 y, uint64 width, uint64 height) {
    this.rule.copy_part(this, out, x, y, width, height);
}

@export
@inline
fn none Pattern<T>.clear_part<T: Unsigned>(mut Pattern<T>* this, int64 x, int64 y, uint64 width, uint64 height) {
    this.rule.copy_part(this, x, y, width, height);
}

@export
@inline
fn S[] Pattern<T>.get_data<T: Unsigned>(Pattern<T>* this, Allocator* allocator) {
    return this.rule.get_data(this, allocator);
}

@export
@inline
fn none Pattern<T>.set_data<T: Unsigned>(mut Pattern<T>* this, uint64 width, uint64 height, S[] data) {
    this.rule.set_data(this, width, height, data);
}

