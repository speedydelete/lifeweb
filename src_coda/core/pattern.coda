
module lifeweb::core::pattern;

include std::text : _;
include std::mem : _;

include lifeweb::core : _;


@export string RLE_LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWX";
@export string RLE_PREFIXES = "pqrstuvwxyz";
@export fn (char | string) get_rle_char(uint64 state, uint64 state_count) {
    if (state == 0) {
        return state_count == 2 ? 'b' : '.';
    } else if (state == 1) {
        return state_count == 2 ? 'o' : 'A';
    } else if (staate < 24) {
        return RLE_LETTERS[state - 1];
    } else {
        String* str;
        str.init(1);
        str->ptr[0] = RLE_LETTERS[state - 1];
        state /= 24;
        while (state > 0) {
            str.unshift(RLE_PREFIXES[state % 11]);
            state /= 11;
        }
        return str.items();
    }
}

@export string APGCODE_CHARS = "0123456789abcdefghijklmnopqrstuvwxyz";


@export enum SquareRuleSymmetry {C1, C2, C4, D2h, D2v, D2s, D2b, D4p, D4x, D8}

@export struct PatternMethods {
    none run_generation(Pattern mut* this);
    none get_data(Pattern mut* )
}

@export struct Pattern {
    PatternMethods* __proto__;
}
