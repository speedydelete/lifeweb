{
    "compilerOptions": {
        "rootDir": "./src_old",
        "outDir": "./lib_old",
        "lib": ["ESNext", "DOM"],
        "target": "ESNext",
        "module": "NodeNext",
        "types": ["node"],
        "resolveJsonModule": true,
        "strict": true,
        "sourceMap": true,
        "declaration": true
    },
    "include": ["./src_old/**/*.ts"],
    "references": [
        {"path": "./src_old/core"},
        {"path": "./src_old/editor"},
        {"path": "./src_old/identify"},
        {"path": "./src_old/misc"},
        {"path": "./src_old/rule_symmetries"},
        {"path": "./src_old/uc"},
        {"path": "./src_old/vls"}
    ]
}