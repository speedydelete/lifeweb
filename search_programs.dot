
digraph search_programs {
    
    pad = "0.5"
    node [shape = box, style = rounded]

    "LS" [label="LS (1988, 6502 + BASIC, Dean Hickerson)", URL="https://github.com/DavidKinder/Xlife/blob/master/Xlife35/source/lifesearch/ORIGIN"]
    "lifesrc" [label="lifesrc (1992?, C, David Bell)", URL="https://github.com/DavidKinder/Xlife/tree/master/Xlife35/source/lifesearch"]
    "WLS" [label="WLS / WinLifeSearch (2012, C, Jason Summers)", URL="https://github.com/jsummers/winlifesearch/"]
    "JLS" [label="JLS / JavaLifeSearch (2012, Java, Karel Suhajda)", URL="https://conwaylife.com/forums/viewtopic.php?f=9&t=990"]
    "LLS" [label="LLS / Logic Life Search (2018, Python + C/C++, Oscar Cunningham)", URL="https://gitlab.com/OscarCunningham/logic-life-search/"]
    "RLS" [label="RLS / Rust Life Search (2019, Rust, AlephAlpha)", URL="https://github.com/AlephAlpha/rlifesrc"]
    "VLS" [label="VLS / Variable Life Search (2026, C + TS, speedydelete)", URL="https://github.com/speedydelete/lifeweb/tree/main/src/vls"]

    "LS" -> "lifesrc"
    "lifesrc" -> "WLS"
    "lifesrc" -> "JLS"
    "WLS" -> "JLS"
    "JLS" -> "WLS"
    "lifesrc" -> "LLS"
    "WLS" -> "LLS"
    "JLS" -> "LLS"
    "lifesrc" -> "RLS"
    "WLS" -> "RLS"
    "lifesrc" -> "VLS"
    "JLS" -> "VLS"
    "LLS" -> "VLS"
    "RLS" -> "VLS"

    "knight" [label="knight (1996, ?, Tim Coe)", URL="https://arxiv.org/pdf/cs/0004003"]
    "knight2" [label="knight2 (2015?, C, Tim Coe)", URL="https://conwaylife.com/forums/viewtopic.php?t=1969"]
    "knightt" [label="knightt (2016, C, Tim Coe)", URL="https://conwaylife.com/forums/viewtopic.php?p=28891#p28891"]

    "lifesrc" -> "knight"
    "knight" -> "knight2"
    "knight2" -> "knightt"

    "gfind" [label="gfind (1998, C, David Eppstein)", URL="https://ics.uci.edu/~eppstein/ca/gfind.c"]

    "knight" -> "gfind"

    "GOL" [label="GOL (2002?, ?, Keith Amling)", URL="https://conwaylife.com/forums/viewtopic.php?p=145090#p145090"]
    "LGOL" [label="LGOL (?, ?, Keith Amling)", URL="https://conwaylife.com/forums/viewtopic.php?p=145091#p145091"]
    "LSSS" [label="LSSS / Life Slice Ship Search (2018, Rust, Andrew Wade)", URL="https://codeberg.org/ajwade/life_slice_ship_search"]
    "LLSSS" [label="LLSSS / Lattice Life Slice Ship Search (2022, Rust, Keith Amling)", URL="https://codeberg.org/amling/rlife/"]

    "gfind" -> "GOL"
    "GOL" -> "LGOL"
    "gfind" -> "LSSS"
    "LGOL" -> "LLSSS"
    "LSSS" -> "LLSSS"

}
